#include <Servo.h>

Servo servoo;
Servo servo2;

const int touchPin = 9;
const int servoPin = 8;

const int touchPin2 = 3;
const int servoPin2 = 2;

void setup() {
  pinMode(touchPin, INPUT_PULLUP);
  pinMode(touchPin2, INPUT_PULLUP);

  servoo.attach(servoPin);
  servo2.attach(servoPin2);

  servoo.write(0);
  servo2.write(0);
}

void loop() {
  // servo one
  if (digitalRead(touchPin) == LOW) {
    servoo.write(90);
  } else {
    servoo.write(0);
  }
  //servo 2
  if (digitalRead(touchPin2) == LOW) {
    servo2.write(90);
  } else {
    servo2.write(0);
  }

  delay(15);
}
